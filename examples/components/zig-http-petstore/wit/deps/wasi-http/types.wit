// Trimmed `wasi:http/types@0.2.6` interface — only the resources and
// methods the zig-http-petstore handler links against. No `package`
// directive: `incoming-handler.wit` (sorts first alphabetically)
// carries it, and cataggar/wabt's WIT loader concatenates files in a
// directory before parsing.
//
// Resource ordering is significant: cataggar/wabt's encoder binds
// resource names left-to-right as decls are emitted, so every resource
// (and named type) must appear before any other decl that references
// it. Dep chain:
//
//   fields ─┐
//           ├─► outgoing-body ──► outgoing-response ──┐
//   error-code (variant) ────────┘                    │
//   method (variant) ─┐                                ├─► response-outparam
//   incoming-body ────┴─► incoming-request ────────────┘

interface types {
    /// `wasi:io/streams` handles. `input-stream` is returned by
    /// `[method]incoming-body.stream` (request body); `output-stream`
    /// by `[method]outgoing-body.write` (response body). The world's
    /// `import wasi:io/streams@0.2.6;` makes both resources available
    /// at the world's type-indexspace; this short-form `use` pulls
    /// them into the interface body for in-place references.
    use wasi:io/streams@0.2.6.{input-stream, output-stream};

    /// Headers / trailers map. The handler constructs one per response
    /// and `append`s a single `content-type: application/json` entry.
    resource fields {
        constructor();
        append: func(name: string, value: list<u8>) -> result<_, header-error>;
    }

    /// Header mutation error. Trimmed to the no-payload cases — the
    /// handler ignores the result, so only the shape needs to be valid.
    variant header-error {
        invalid-syntax,
        forbidden,
        immutable,
    }

    /// HTTP transport error variant. Trimmed to a single case — we
    /// never *construct* one (only `response-outparam.set`'s
    /// `result<_, error-code>` payload references the type), so a
    /// catch-all `internal-error` is enough to make the type signature
    /// valid. Upstream wasi:http@0.2.6 enumerates ~30 cases.
    variant error-code {
        internal-error(option<string>),
    }

    /// Request method. The handler reads this to route GET / POST /
    /// DELETE. The `other(string)` arm makes the variant's flat
    /// representation 3 core values `[disc, ptr, len]`, matching the
    /// canonical-ABI lowering the host returns.
    variant method {
        get,
        head,
        post,
        put,
        delete,
        connect,
        options,
        trace,
        patch,
        other(string),
    }

    /// Incoming request body — `stream` peels off a single
    /// `input-stream` the handler `blocking-read`s the `POST /pets`
    /// JSON payload from.
    resource incoming-body {
        %stream: func() -> result<input-stream>;
    }

    /// Outgoing-body. `write` peels off a single `output-stream`;
    /// `[static]finish` releases the body resource and resolves the
    /// `result<_, error-code>` returned to the caller.
    resource outgoing-body {
        write: func() -> result<output-stream>;
        finish: static func(
            this: own<outgoing-body>,
            trailers: option<own<fields>>
        ) -> result<_, error-code>;
    }

    /// Outgoing-response. The handler constructs one with a headers
    /// map (carrying `content-type`), optionally bumps
    /// `set-status-code` (defaults to 200), then calls `body` to obtain
    /// the `outgoing-body` it streams the JSON payload through.
    resource outgoing-response {
        constructor(headers: own<fields>);
        set-status-code: func(status-code: u16) -> result;
        body: func() -> result<outgoing-body>;
    }

    /// Incoming-request — the handler reads `method` + `path-with-query`
    /// to route, and `consume`s the body for `POST /pets`.
    resource incoming-request {
        method: func() -> method;
        path-with-query: func() -> option<string>;
        consume: func() -> result<incoming-body>;
    }

    /// Response-outparam — the slot the host passes us so we can hand
    /// back the constructed `outgoing-response` (or an `error-code`).
    /// The handler calls `set` exactly once.
    resource response-outparam {
        set: static func(
            param: own<response-outparam>,
            response: result<own<outgoing-response>, error-code>
        );
    }
}
