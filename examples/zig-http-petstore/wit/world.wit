// World for the keyvalue-backed Zig petstore. Unlike the trimmed
// `zig-http` world, this imports the **canonical** (full, unmodified)
// `wasi:http` / `wasi:io` / `wasi:clocks` interfaces vendored under
// `deps/`, so the component's types match exactly what `wasmtime serve`
// provides — letting the same binary run on both wamr and wasmtime.
//
// Imports:
//   * `wasi:http/types` + `wasi:io/streams` — request/response handling.
//   * `wasi:keyvalue/store` — host-backed pet storage (survives across
//     requests even when the runtime re-instantiates per request).
// Export: `wasi:http/incoming-handler`.
//
// World-import order matters: `wasi:io/streams` is imported before
// `wasi:http/types` (whose body `use`s it), matching cataggar/wabt's
// alias-emit ordering. Plain `//` comments before `package` per
// cataggar/wabt#192.
package example:zig-http-petstore;

world petstore {
    import wasi:io/streams@0.2.6;
    import wasi:http/types@0.2.6;
    import wasi:keyvalue/store@0.2.0-draft2;
    export wasi:http/incoming-handler@0.2.6;
}
