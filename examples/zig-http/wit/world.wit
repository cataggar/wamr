package example:zig-http;

world http-hello {
    // output-stream blocking-write-and-flush + drop: writes the body.
    import wasi:io/streams@0.2.6;
    // resource constructors/methods the handler calls to build the response.
    import wasi:http/types@0.2.6;
    // incoming-handler: the entry point wamr dispatches requests to.
    export wasi:http/incoming-handler@0.2.6;
}
