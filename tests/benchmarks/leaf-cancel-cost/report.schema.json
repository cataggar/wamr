{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cataggar/wamr/tests/benchmarks/leaf-cancel-cost/report.schema.json",
  "title": "WAMR issue 963 leaf-call cancel-poll cost report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "metadata",
    "plan",
    "pilot",
    "warmups",
    "records",
    "summaries",
    "comparison",
    "quality"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "leaf-cancel-cost" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "plan": { "$ref": "#/$defs/plan" },
    "pilot": {
      "anyOf": [
        { "type": "null" },
        {
          "allOf": [
            { "$ref": "#/$defs/invocation" },
            { "properties": { "phase": { "const": "pilot" } } }
          ]
        }
      ]
    },
    "warmups": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "#/$defs/invocation" },
          { "properties": { "phase": { "const": "warmup" } } }
        ]
      }
    },
    "records": {
      "type": "array",
      "minItems": 4,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/invocation" },
          { "properties": { "phase": { "const": "sample" } } }
        ]
      }
    },
    "summaries": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/summary" }
    },
    "comparison": { "$ref": "#/$defs/comparison" },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "equivalent_guest_work",
        "equivalent_checksums",
        "all_intervals_passed",
        "all_timing_overhead_below_one_percent"
      ],
      "properties": {
        "equivalent_guest_work": { "const": true },
        "equivalent_checksums": { "const": true },
        "all_intervals_passed": { "const": true },
        "all_timing_overhead_below_one_percent": { "const": true }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "command": {
      "type": "array",
      "items": { "type": "string" }
    },
    "file_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "bytes"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "tracked_diff_sha256",
        "build_source_sha256",
        "harness_files"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tracked_diff_sha256": { "$ref": "#/$defs/sha256" },
        "build_source_sha256": { "$ref": "#/$defs/sha256" },
        "harness_files": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/file_identity" }
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "toolchain"],
      "properties": {
        "path": { "const": "tests/benchmarks/leaf-cancel-cost/leaf_calls.wasm" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 },
        "toolchain": {
          "type": "object",
          "additionalProperties": false,
          "required": ["wasi_sdk_version", "clang", "archive_sha256"],
          "properties": {
            "wasi_sdk_version": { "const": "25.0" },
            "clang": { "const": "clang version 19.1.5-wasi-sdk" },
            "archive_sha256": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "release",
        "version",
        "machine",
        "processor",
        "cpu",
        "logical_cpus",
        "python",
        "runner_name",
        "runner_image",
        "runner_os",
        "runner_arch",
        "runner_environment",
        "github_run_id",
        "github_run_attempt",
        "github_workflow",
        "host_fingerprint"
      ],
      "properties": {
        "system": { "type": "string", "minLength": 1 },
        "release": { "type": "string" },
        "version": { "type": "string" },
        "machine": { "type": "string", "minLength": 1 },
        "processor": { "type": "string" },
        "cpu": { "type": "string", "minLength": 1 },
        "logical_cpus": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "python": { "type": "string", "minLength": 1 },
        "runner_name": { "type": "string" },
        "runner_image": { "type": "string" },
        "runner_os": { "type": "string" },
        "runner_arch": { "type": "string" },
        "runner_environment": { "type": "string", "minLength": 1 },
        "github_run_id": { "type": "string" },
        "github_run_attempt": { "type": "string" },
        "github_workflow": { "type": "string" },
        "host_fingerprint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sha256", "fields"],
          "properties": {
            "sha256": { "$ref": "#/$defs/sha256" },
            "fields": {
              "type": "object",
              "required": [
                "system",
                "machine",
                "cpu",
                "logical_cpus",
                "runner_environment",
                "runner_image",
                "runner_os",
                "runner_arch"
              ]
            }
          }
        }
      }
    },
    "build_tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build_command",
        "cache_key",
        "wamrc_path",
        "wamrc_sha256",
        "wamrc_version"
      ],
      "properties": {
        "build_command": { "$ref": "#/$defs/command" },
        "cache_key": { "$ref": "#/$defs/sha256" },
        "wamrc_path": { "type": "string", "minLength": 1 },
        "wamrc_sha256": { "$ref": "#/$defs/sha256" },
        "wamrc_version": { "type": "string", "minLength": 1 }
      }
    },
    "runtime_tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build_command",
        "cache_key",
        "wamr_path",
        "wamr_sha256",
        "wamr_version"
      ],
      "properties": {
        "build_command": { "$ref": "#/$defs/command" },
        "cache_key": { "$ref": "#/$defs/sha256" },
        "wamr_path": { "type": "string", "minLength": 1 },
        "wamr_sha256": { "$ref": "#/$defs/sha256" },
        "wamr_version": { "type": "string", "minLength": 1 }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zig", "python", "compiler", "runtime"],
      "properties": {
        "zig": { "type": "string", "minLength": 1 },
        "python": { "type": "string", "minLength": 1 },
        "compiler": { "$ref": "#/$defs/build_tool" },
        "runtime": { "$ref": "#/$defs/runtime_tool" }
      }
    },
    "artifact_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "file_bytes", "text_bytes"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "file_bytes": { "type": "integer", "minimum": 1 },
        "text_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture",
        "cancel_poll_signature_hex",
        "cancel_poll_sites_enabled",
        "cancel_poll_sites_disabled",
        "text_delta_bytes",
        "bytes_per_poll_site",
        "conditions"
      ],
      "properties": {
        "architecture": { "enum": ["x86_64", "aarch64"] },
        "cancel_poll_signature_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]+$"
        },
        "cancel_poll_sites_enabled": { "type": "integer", "minimum": 1 },
        "cancel_poll_sites_disabled": { "const": 0 },
        "text_delta_bytes": { "type": "integer", "minimum": 1 },
        "bytes_per_poll_site": { "type": "integer", "minimum": 1 },
        "conditions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cancel-points-off", "cancel-points-on"],
          "properties": {
            "cancel-points-off": { "$ref": "#/$defs/artifact_condition" },
            "cancel-points-on": { "$ref": "#/$defs/artifact_condition" }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "aot_target",
        "runner",
        "host_cpu_affinity",
        "optimize"
      ],
      "properties": {
        "target": { "type": "string", "minLength": 1 },
        "aot_target": { "enum": ["x86_64", "aarch64"] },
        "runner": { "$ref": "#/$defs/command" },
        "host_cpu_affinity": {
          "type": "array",
          "maxItems": 1,
          "items": { "type": "integer", "minimum": 0 }
        },
        "optimize": { "type": "string", "minLength": 1 }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collected_at",
        "platform_id",
        "source",
        "fixture",
        "host",
        "tools",
        "artifacts",
        "execution"
      ],
      "properties": {
        "collected_at": { "type": "string", "format": "date-time" },
        "platform_id": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/source" },
        "fixture": { "$ref": "#/$defs/fixture" },
        "host": { "$ref": "#/$defs/host" },
        "tools": { "$ref": "#/$defs/tools" },
        "artifacts": { "$ref": "#/$defs/artifacts" },
        "execution": { "$ref": "#/$defs/execution" }
      }
    },
    "sizing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "pilot_calls", "selected_calls"],
      "properties": {
        "kind": {
          "enum": [
            "single-enabled-pilot-linear-scale",
            "explicit-call-count"
          ]
        },
        "pilot_calls": {
          "type": ["integer", "null"],
          "minimum": 64,
          "maximum": 10000000000,
          "multipleOf": 64
        },
        "selected_calls": {
          "type": "integer",
          "minimum": 64,
          "maximum": 10000000000,
          "multipleOf": 64
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "scope",
        "leaf_calls",
        "leaf_unroll",
        "batches",
        "leaf_entry_poll_opportunities_per_enabled_sample",
        "non_leaf_poll_opportunities_upper_bound_per_enabled_sample",
        "minimum_leaf_entry_poll_share",
        "warmups",
        "samples",
        "minimum_interval_ns",
        "target_interval_ns",
        "pair_order",
        "clock_id",
        "sizing"
      ],
      "properties": {
        "identity": { "const": "issue-963-leaf-cancel-cost-v1" },
        "scope": { "const": "isolated-from-wasi-thread-benchmark-966" },
        "leaf_calls": {
          "type": "integer",
          "minimum": 64,
          "maximum": 10000000000,
          "multipleOf": 64
        },
        "leaf_unroll": { "const": 64 },
        "batches": { "type": "integer", "minimum": 1 },
        "leaf_entry_poll_opportunities_per_enabled_sample": {
          "type": "integer",
          "minimum": 64,
          "maximum": 10000000000,
          "multipleOf": 64
        },
        "non_leaf_poll_opportunities_upper_bound_per_enabled_sample": {
          "type": "integer",
          "minimum": 2
        },
        "minimum_leaf_entry_poll_share": {
          "type": "number",
          "exclusiveMinimum": 0.96,
          "maximum": 1
        },
        "warmups": { "type": "integer", "minimum": 0, "maximum": 2 },
        "samples": {
          "type": "integer",
          "minimum": 2,
          "maximum": 12,
          "multipleOf": 2
        },
        "minimum_interval_ns": { "type": "integer", "minimum": 1 },
        "target_interval_ns": { "type": "integer", "minimum": 1 },
        "pair_order": { "const": "alternating-off-on/on-off" },
        "clock_id": { "const": "wasi-process-cputime" },
        "sizing": { "$ref": "#/$defs/sizing" }
      }
    },
    "guest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "leaf_calls",
        "leaf_unroll",
        "batches",
        "checksum",
        "clock_id",
        "raw_elapsed_ns",
        "timing_overhead_ns",
        "elapsed_ns",
        "timing_overhead_ppm"
      ],
      "properties": {
        "kind": { "const": "leaf-cancel-cost-result" },
        "leaf_calls": {
          "type": "integer",
          "minimum": 64,
          "maximum": 10000000000,
          "multipleOf": 64
        },
        "leaf_unroll": { "const": 64 },
        "batches": { "type": "integer", "minimum": 1 },
        "checksum": { "type": "integer", "minimum": 0 },
        "clock_id": { "const": "wasi-process-cputime" },
        "raw_elapsed_ns": { "type": "integer", "minimum": 1 },
        "timing_overhead_ns": { "type": "integer", "minimum": 0 },
        "elapsed_ns": { "type": "integer", "minimum": 1 },
        "timing_overhead_ppm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "pair_index",
        "position",
        "condition",
        "command",
        "leaf_calls",
        "leaf_entry_poll_opportunities",
        "batches",
        "guest_elapsed_ns",
        "raw_guest_elapsed_ns",
        "timing_overhead_ns",
        "timing_overhead_ppm",
        "host_wall_elapsed_ns",
        "leaf_calls_per_second",
        "guest",
        "correct"
      ],
      "properties": {
        "phase": { "enum": ["pilot", "warmup", "sample"] },
        "pair_index": { "type": "integer", "minimum": 0 },
        "position": { "type": "integer", "minimum": 0, "maximum": 1 },
        "condition": {
          "enum": ["cancel-points-off", "cancel-points-on"]
        },
        "command": {
          "type": "array",
          "minItems": 4,
          "items": { "type": "string" }
        },
        "leaf_calls": {
          "type": "integer",
          "minimum": 64,
          "maximum": 10000000000,
          "multipleOf": 64
        },
        "leaf_entry_poll_opportunities": {
          "type": "integer",
          "minimum": 0
        },
        "batches": { "type": "integer", "minimum": 1 },
        "guest_elapsed_ns": { "type": "integer", "minimum": 1 },
        "raw_guest_elapsed_ns": { "type": "integer", "minimum": 1 },
        "timing_overhead_ns": { "type": "integer", "minimum": 0 },
        "timing_overhead_ppm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "host_wall_elapsed_ns": { "type": "integer", "minimum": 1 },
        "leaf_calls_per_second": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "guest": { "$ref": "#/$defs/guest" },
        "correct": { "const": true }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["samples", "runs", "mean", "median", "min", "max", "range"],
      "properties": {
        "samples": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "number" }
        },
        "runs": { "type": "integer", "minimum": 1 },
        "mean": { "type": "number" },
        "median": { "type": "number" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "range": { "type": "number", "minimum": 0 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "condition",
        "guest_elapsed_ns",
        "leaf_calls_per_second",
        "host_wall_elapsed_ns"
      ],
      "properties": {
        "condition": {
          "enum": ["cancel-points-off", "cancel-points-on"]
        },
        "guest_elapsed_ns": { "$ref": "#/$defs/stats" },
        "leaf_calls_per_second": { "$ref": "#/$defs/stats" },
        "host_wall_elapsed_ns": { "$ref": "#/$defs/stats" }
      }
    },
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pair_index",
        "on_over_off_elapsed_ratio",
        "on_minus_off_ns",
        "on_minus_off_ns_per_leaf_call",
        "on_over_off_throughput_ratio"
      ],
      "properties": {
        "pair_index": { "type": "integer", "minimum": 0 },
        "on_over_off_elapsed_ratio": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "on_minus_off_ns": { "type": "integer" },
        "on_minus_off_ns_per_leaf_call": { "type": "number" },
        "on_over_off_throughput_ratio": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pairs",
        "median_on_over_off_elapsed_ratio",
        "median_elapsed_delta_percent",
        "median_on_minus_off_ns_per_leaf_call",
        "median_on_over_off_throughput_ratio"
      ],
      "properties": {
        "pairs": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/pair" }
        },
        "median_on_over_off_elapsed_ratio": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "median_elapsed_delta_percent": { "type": "number" },
        "median_on_minus_off_ns_per_leaf_call": { "type": "number" },
        "median_on_over_off_throughput_ratio": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}
