{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cataggar/wamr/tests/benchmarks/wasi-threads/report.schema.json",
  "title": "Paired-revision WAMR WASI thread benchmark report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "metadata",
    "plan",
    "records",
    "summaries",
    "paired_summaries",
    "comparison_summaries",
    "ratio_of_ratios_summaries",
    "quality_preflight",
    "budget"
  ],
  "properties": {
    "schema_version": { "const": 3 },
    "kind": { "const": "wasi-thread-benchmark" },
    "metadata": {
      "type": "object",
      "required": [
        "commit",
        "tracked_diff_sha256",
        "build_source_sha256",
        "revisions",
        "revision_checkouts",
        "collected_at",
        "platform_id",
        "fixture_set_sha256",
        "plan_sha256",
        "measurement_plan_version",
        "measurement_plan_sha256",
        "host",
        "host_pair",
        "execution",
        "tools",
        "fixture_toolchain",
        "fixtures"
      ],
      "properties": {
        "commit": { "$ref": "#/$defs/commit" },
        "tracked_diff_sha256": { "$ref": "#/$defs/sha256" },
        "build_source_sha256": { "$ref": "#/$defs/sha256" },
        "revisions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "baseline": { "$ref": "#/$defs/revision" },
            "candidate": { "$ref": "#/$defs/revision" }
          }
        },
        "revision_checkouts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "baseline": { "type": "string", "minLength": 1 },
            "candidate": { "type": "string", "minLength": 1 }
          }
        },
        "collected_at": { "type": "string", "minLength": 1 },
        "platform_id": { "type": "string", "minLength": 1 },
        "fixture_set_sha256": { "$ref": "#/$defs/sha256" },
        "plan_sha256": { "$ref": "#/$defs/sha256" },
        "measurement_plan_version": { "const": 1 },
        "measurement_plan_sha256": { "$ref": "#/$defs/sha256" },
        "host": {
          "type": "object",
          "required": [
            "system",
            "machine",
            "runner_environment",
            "host_fingerprint"
          ],
          "properties": {
            "system": { "type": "string", "minLength": 1 },
            "machine": { "type": "string", "minLength": 1 },
            "runner_name": { "type": "string" },
            "runner_environment": { "type": "string", "minLength": 1 },
            "host_fingerprint": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sha256", "fields"],
              "properties": {
                "sha256": { "$ref": "#/$defs/sha256" },
                "fields": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "system",
                    "machine",
                    "cpu",
                    "logical_cpus",
                    "runner_environment",
                    "runner_image",
                    "runner_os",
                    "runner_arch"
                  ],
                  "properties": {
                    "system": { "type": "string" },
                    "machine": { "type": "string" },
                    "cpu": { "type": "string" },
                    "logical_cpus": {
                      "type": ["integer", "null"],
                      "minimum": 1
                    },
                    "runner_environment": {
                      "type": "string",
                      "minLength": 1
                    },
                    "runner_image": { "type": "string" },
                    "runner_os": { "type": "string" },
                    "runner_arch": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "host_pair": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "runner_environment",
            "host_fingerprint_sha256"
          ],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "runner_environment": { "type": "string", "minLength": 1 },
            "host_fingerprint_sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "execution": { "type": "object" },
        "tools": { "type": "object" },
        "fixture_toolchain": { "type": "object" },
        "fixtures": { "type": "object" },
        "aot_artifacts": { "type": "object" }
      }
    },
    "plan": {
      "type": "object",
      "required": [
        "profile",
        "warmups",
        "samples",
        "revision_mode",
        "comparison_purpose",
        "revision_roles",
        "modes",
        "thread_counts",
        "iterations",
        "timeout_seconds",
        "minimum_timed_interval_ns",
        "atomic_wait_preflight_runs",
        "scheduler_barrier_preflight",
        "pairs",
        "optimize"
      ],
      "properties": {
        "profile": { "enum": ["authoritative", "smoke"] },
        "warmups": { "type": "integer", "minimum": 0 },
        "samples": { "type": "integer", "minimum": 1 },
        "revision_mode": {
          "enum": ["paired-revisions", "single-revision-compatibility"]
        },
        "comparison_purpose": {
          "enum": [
            "candidate-evaluation",
            "noise-calibration",
            "single-revision-compatibility"
          ]
        },
        "revision_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/revision_role" }
        },
        "modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["interpreter", "aot"] }
        },
        "thread_counts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": [1, 2, 4, 8] }
        },
        "iterations": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "interpreter": {
              "$ref": "#/$defs/interpreter_iteration_plan"
            },
            "aot": { "$ref": "#/$defs/aot_iteration_plan" }
          }
        },
        "timeout_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "minimum_timed_interval_ns": {
          "type": "integer",
          "minimum": 1250000000
        },
        "atomic_wait_preflight_runs": {
          "type": "integer",
          "minimum": 1
        },
        "scheduler_barrier_preflight": {
          "$ref": "#/$defs/scheduler_barrier_preflight_plan"
        },
        "pairs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/pair" }
        },
        "optimize": { "type": "string", "minLength": 1 }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/record" }
    },
    "summaries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/revision_summary" }
    },
    "paired_summaries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/paired_summary" }
    },
    "comparison_summaries": {
      "type": "array",
      "items": { "$ref": "#/$defs/comparison_summary" }
    },
    "ratio_of_ratios_summaries": {
      "type": "array",
      "items": { "$ref": "#/$defs/ratio_of_ratios_summary" }
    },
    "quality_preflight": {
      "$ref": "#/$defs/quality_preflight"
    },
    "budget": {
      "type": "object",
      "required": ["status", "path", "failures"],
      "properties": {
        "status": {
          "enum": ["disabled", "not-selected", "passed", "failed"]
        },
        "path": { "type": ["string", "null"] },
        "failures": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "plan": {
            "properties": {
              "revision_mode": { "const": "paired-revisions" }
            },
            "required": ["revision_mode"]
          }
        },
        "required": ["plan"]
      },
      "then": {
        "properties": {
          "metadata": {
            "properties": {
              "revisions": {
                "required": ["baseline", "candidate"],
                "minProperties": 2
              },
              "revision_checkouts": {
                "required": ["baseline", "candidate"],
                "minProperties": 2
              }
            }
          },
          "plan": {
            "properties": {
              "comparison_purpose": {
                "enum": ["candidate-evaluation", "noise-calibration"]
              },
              "revision_roles": { "const": ["baseline", "candidate"] },
              "samples": { "multipleOf": 2, "minimum": 2 }
            }
          },
          "comparison_summaries": { "minItems": 1 },
          "ratio_of_ratios_summaries": { "minItems": 1 }
        }
      },
      "else": {
        "properties": {
          "metadata": {
            "properties": {
              "revisions": {
                "required": ["candidate"],
                "maxProperties": 1
              },
              "revision_checkouts": {
                "required": ["candidate"],
                "maxProperties": 1
              }
            }
          },
          "plan": {
            "properties": {
              "comparison_purpose": {
                "const": "single-revision-compatibility"
              },
              "revision_roles": { "const": ["candidate"] }
            }
          },
          "comparison_summaries": { "maxItems": 0 },
          "ratio_of_ratios_summaries": { "maxItems": 0 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "plan": {
            "properties": {
              "comparison_purpose": { "const": "noise-calibration" }
            },
            "required": ["comparison_purpose"]
          }
        }
      },
      "then": {
        "properties": {
          "budget": {
            "properties": {
              "status": { "const": "disabled" },
              "path": { "type": "null" },
              "failures": { "maxItems": 0 }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revision_role": {
      "enum": ["baseline", "candidate"]
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "tracked_diff_sha256",
        "build_source_sha256",
        "fixture_set_sha256",
        "plan_sha256",
        "host_pair_id",
        "host_fingerprint_sha256"
      ],
      "properties": {
        "commit": { "$ref": "#/$defs/commit" },
        "tracked_diff_sha256": { "$ref": "#/$defs/sha256" },
        "build_source_sha256": { "$ref": "#/$defs/sha256" },
        "fixture_set_sha256": { "$ref": "#/$defs/sha256" },
        "plan_sha256": { "$ref": "#/$defs/sha256" },
        "host_pair_id": { "type": "string", "minLength": 1 },
        "host_fingerprint_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pair_kind", "pair_key", "left", "right"],
      "properties": {
        "pair_kind": { "type": "string", "minLength": 1 },
        "pair_key": { "type": "string", "minLength": 1 },
        "left": { "type": "string", "minLength": 1 },
        "right": { "type": "string", "minLength": 1 }
      }
    },
    "scheduler_barrier_preflight_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "mode",
        "workload",
        "probes_per_thread",
        "probe_count",
        "timing_overhead_ratio_limit",
        "target_barrier_ns",
        "target_required_interval_ns",
        "minimum_interval_headroom_ns",
        "maximum_accepted_barrier_ns",
        "acceptance_rule"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "mode": { "const": "aot" },
        "workload": { "const": "hot" },
        "probes_per_thread": { "const": 4 },
        "probe_count": { "type": "integer", "minimum": 0 },
        "timing_overhead_ratio_limit": { "const": 0.01 },
        "target_barrier_ns": { "const": 12456000 },
        "target_required_interval_ns": { "const": 1233144000 },
        "minimum_interval_headroom_ns": {
          "type": "integer",
          "minimum": 16856000
        },
        "maximum_accepted_barrier_ns": {
          "type": "integer",
          "minimum": 0
        },
        "acceptance_rule": { "type": "string", "minLength": 1 }
      }
    },
    "quality_preflight_sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probe_index",
        "mode",
        "workload",
        "threads",
        "iterations",
        "timing_overhead_ns",
        "timed_interval_ns",
        "raw_elapsed_ns",
        "timing_overhead_ppm",
        "timing_overhead_ratio",
        "ratio_at_minimum_timed_interval",
        "accepted"
      ],
      "properties": {
        "probe_index": { "type": "integer", "minimum": 0 },
        "mode": { "const": "aot" },
        "workload": { "const": "hot" },
        "threads": { "enum": [1, 2, 4, 8] },
        "iterations": { "type": "integer", "minimum": 1 },
        "timing_overhead_ns": { "type": "integer", "minimum": 0 },
        "timed_interval_ns": { "type": "integer", "minimum": 1 },
        "raw_elapsed_ns": { "type": "integer", "minimum": 1 },
        "timing_overhead_ppm": { "type": "integer", "minimum": 0 },
        "timing_overhead_ratio": { "type": "number", "minimum": 0 },
        "ratio_at_minimum_timed_interval": {
          "type": "number",
          "minimum": 0
        },
        "accepted": { "type": "boolean" }
      }
    },
    "quality_preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "status",
        "probe_count",
        "probes_per_thread",
        "mode",
        "workload",
        "thread_counts",
        "minimum_timed_interval_ns",
        "timing_overhead_ratio_limit",
        "maximum_accepted_barrier_ns",
        "acceptance_rule",
        "summary",
        "samples",
        "host_quiescence_at_start"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "status": { "enum": ["not-requested", "passed"] },
        "probe_count": { "type": "integer", "minimum": 0 },
        "probes_per_thread": { "const": 4 },
        "mode": { "const": "aot" },
        "workload": { "const": "hot" },
        "thread_counts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": [1, 2, 4, 8] }
        },
        "minimum_timed_interval_ns": {
          "type": "integer",
          "minimum": 1
        },
        "timing_overhead_ratio_limit": { "const": 0.01 },
        "maximum_accepted_barrier_ns": {
          "type": "integer",
          "minimum": 0
        },
        "acceptance_rule": { "type": "string", "minLength": 1 },
        "summary": {
          "type": ["object", "null"]
        },
        "samples": {
          "type": "array",
          "items": { "$ref": "#/$defs/quality_preflight_sample" }
        },
        "host_quiescence_at_start": { "type": "object" }
      }
    },
    "thread_iteration_counts": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "1": { "type": "integer", "minimum": 1 },
        "2": { "type": "integer", "minimum": 1 },
        "4": { "type": "integer", "minimum": 1 },
        "8": { "type": "integer", "minimum": 1 }
      }
    },
    "interpreter_iteration_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "single-hot",
        "hot",
        "atomic",
        "wait-notify",
        "spawn-join"
      ],
      "properties": {
        "single-hot": { "type": "integer", "minimum": 1 },
        "hot": { "$ref": "#/$defs/thread_iteration_counts" },
        "atomic": { "$ref": "#/$defs/thread_iteration_counts" },
        "wait-notify": { "$ref": "#/$defs/thread_iteration_counts" },
        "spawn-join": { "$ref": "#/$defs/thread_iteration_counts" }
      }
    },
    "aot_iteration_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "single-hot",
        "hot",
        "atomic",
        "wait-notify",
        "spawn-join",
        "cancel-hot"
      ],
      "properties": {
        "single-hot": { "type": "integer", "minimum": 1 },
        "hot": { "$ref": "#/$defs/thread_iteration_counts" },
        "atomic": { "$ref": "#/$defs/thread_iteration_counts" },
        "wait-notify": { "$ref": "#/$defs/thread_iteration_counts" },
        "spawn-join": { "$ref": "#/$defs/thread_iteration_counts" },
        "cancel-hot": { "$ref": "#/$defs/thread_iteration_counts" }
      }
    },
    "stats": {
      "type": "object",
      "required": ["runs", "mean", "median", "min", "max", "range"],
      "properties": {
        "runs": { "type": "integer", "minimum": 1 },
        "mean": { "type": "number" },
        "median": { "type": "number" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "range": { "type": "number", "minimum": 0 },
        "samples": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "number" }
        },
        "samples_ns": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "number" }
        },
        "samples_ops_per_second": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "number" }
        }
      }
    },
    "record": {
      "type": "object",
      "required": [
        "revision",
        "revision_order",
        "revision_commit",
        "revision_build_source_sha256",
        "fixture_set_sha256",
        "plan_sha256",
        "host_pair_id",
        "host_fingerprint_sha256",
        "pair_kind",
        "pair_key",
        "pair_index",
        "phase",
        "order",
        "condition",
        "pair_left",
        "pair_right",
        "mode",
        "threads_enabled",
        "cancel_points",
        "workload",
        "threads",
        "iterations",
        "command",
        "elapsed_ns",
        "guest_elapsed_ns",
        "raw_guest_elapsed_ns",
        "timing_overhead_ns",
        "timing_overhead_ppm",
        "host_wall_elapsed_ns",
        "host_wall_over_guest",
        "metric_kind",
        "cancel_polls_per_operation",
        "static_cancel_poll_sites",
        "operations",
        "throughput_ops_per_second",
        "per_thread_ops_per_second",
        "guest",
        "correct",
        "correctness",
        "stdout",
        "stderr"
      ],
      "properties": {
        "revision": { "$ref": "#/$defs/revision_role" },
        "revision_order": { "enum": [0, 1] },
        "revision_commit": { "$ref": "#/$defs/commit" },
        "revision_build_source_sha256": { "$ref": "#/$defs/sha256" },
        "fixture_set_sha256": { "$ref": "#/$defs/sha256" },
        "plan_sha256": { "$ref": "#/$defs/sha256" },
        "host_pair_id": { "type": "string", "minLength": 1 },
        "host_fingerprint_sha256": { "$ref": "#/$defs/sha256" },
        "pair_kind": { "type": "string", "minLength": 1 },
        "pair_key": { "type": "string", "minLength": 1 },
        "pair_index": { "type": "integer", "minimum": 0 },
        "phase": { "enum": ["warmup", "measure"] },
        "order": { "enum": [0, 1] },
        "condition": { "type": "string", "minLength": 1 },
        "pair_left": { "type": "string", "minLength": 1 },
        "pair_right": { "type": "string", "minLength": 1 },
        "elapsed_ns": { "type": "integer", "minimum": 1 },
        "guest_elapsed_ns": { "type": "integer", "minimum": 1 },
        "throughput_ops_per_second": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "per_thread_ops_per_second": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "correct": { "const": true }
      }
    },
    "revision_summary": {
      "type": "object",
      "required": [
        "revision",
        "pair_kind",
        "pair_key",
        "condition",
        "metric_kind",
        "elapsed",
        "host_wall",
        "throughput",
        "per_thread_throughput"
      ],
      "properties": {
        "revision": { "$ref": "#/$defs/revision_role" },
        "pair_kind": { "type": "string", "minLength": 1 },
        "pair_key": { "type": "string", "minLength": 1 },
        "condition": { "type": "string", "minLength": 1 },
        "metric_kind": {
          "enum": ["steady-state-kernel", "spawn-join-lifecycle"]
        },
        "elapsed": { "$ref": "#/$defs/stats" },
        "host_wall": { "$ref": "#/$defs/stats" },
        "throughput": { "$ref": "#/$defs/stats" },
        "per_thread_throughput": { "$ref": "#/$defs/stats" }
      }
    },
    "paired_summary": {
      "type": "object",
      "required": [
        "revision",
        "pair_kind",
        "pair_key",
        "left",
        "right",
        "elapsed_right_over_left",
        "throughput_right_over_left",
        "median_elapsed_delta_pct",
        "median_throughput_delta_pct"
      ],
      "properties": {
        "revision": { "$ref": "#/$defs/revision_role" },
        "pair_kind": { "type": "string", "minLength": 1 },
        "pair_key": { "type": "string", "minLength": 1 },
        "left": { "type": "string", "minLength": 1 },
        "right": { "type": "string", "minLength": 1 },
        "elapsed_right_over_left": { "$ref": "#/$defs/stats" },
        "throughput_right_over_left": { "$ref": "#/$defs/stats" },
        "median_elapsed_delta_pct": { "type": "number" },
        "median_throughput_delta_pct": { "type": "number" }
      }
    },
    "comparison_summary": {
      "type": "object",
      "required": [
        "pair_kind",
        "pair_key",
        "condition",
        "metric_kind",
        "baseline",
        "candidate",
        "elapsed_candidate_over_baseline",
        "throughput_candidate_over_baseline",
        "median_elapsed_delta_pct",
        "median_throughput_delta_pct"
      ],
      "properties": {
        "pair_kind": { "type": "string", "minLength": 1 },
        "pair_key": { "type": "string", "minLength": 1 },
        "condition": { "type": "string", "minLength": 1 },
        "metric_kind": {
          "enum": ["steady-state-kernel", "spawn-join-lifecycle"]
        },
        "baseline": { "const": "baseline" },
        "candidate": { "const": "candidate" },
        "elapsed_candidate_over_baseline": { "$ref": "#/$defs/stats" },
        "throughput_candidate_over_baseline": { "$ref": "#/$defs/stats" },
        "median_elapsed_delta_pct": { "type": "number" },
        "median_throughput_delta_pct": { "type": "number" }
      }
    },
    "ratio_of_ratios_summary": {
      "type": "object",
      "required": [
        "pair_kind",
