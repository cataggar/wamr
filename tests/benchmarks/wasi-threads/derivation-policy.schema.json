{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cataggar/wamr/tests/benchmarks/wasi-threads/derivation-policy.schema.json",
  "title": "WAMR WASI thread budget derivation policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "minimum_reports_per_platform",
    "rounding_cushion_log",
    "engineering_policy_ceiling_log",
    "direct_candidate_single_infrastructure_max_delta_fraction"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "wasi-thread-budget-derivation-policy" },
    "minimum_reports_per_platform": {
      "type": "integer",
      "minimum": 20
    },
    "rounding_cushion_log": {
      "type": "number",
      "minimum": 0
    },
    "engineering_policy_ceiling_log": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison_throughput_lower",
        "comparison_elapsed_upper",
        "ratio_of_ratios_throughput_lower",
        "ratio_of_ratios_elapsed_upper"
      ],
      "properties": {
        "comparison_throughput_lower": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "comparison_elapsed_upper": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "ratio_of_ratios_throughput_lower": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "ratio_of_ratios_elapsed_upper": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "direct_candidate_single_infrastructure_max_delta_fraction": {
      "const": 0.02
    }
  }
}
