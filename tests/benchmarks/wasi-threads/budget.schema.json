{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cataggar/wamr/tests/benchmarks/wasi-threads/budget.schema.json",
  "title": "Calibrated WAMR WASI thread benchmark budget",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "calibrated",
    "calibration_requirements",
    "cohort",
    "platforms"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "kind": { "const": "wasi-thread-benchmark-budget" },
    "calibrated": { "type": "boolean" },
    "calibration_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_reports_per_platform",
        "required_profile",
        "required_platforms"
      ],
      "properties": {
        "minimum_reports_per_platform": {
          "type": "integer",
          "minimum": 20
        },
        "required_profile": { "const": "authoritative" },
        "required_platforms": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "ubuntu-22.04-x86_64",
              "ubuntu-24.04-aarch64"
            ]
          },
          "allOf": [
            { "contains": { "const": "ubuntu-22.04-x86_64" } },
            { "contains": { "const": "ubuntu-24.04-aarch64" } }
          ]
        }
      }
    },
    "cohort": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "baseline_commit",
            "baseline_build_source_sha256",
            "fixture_set_sha256",
            "plan_sha256",
            "profile",
            "report_count_by_platform"
          ],
          "properties": {
            "baseline_commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "baseline_build_source_sha256": { "$ref": "#/$defs/sha256" },
            "fixture_set_sha256": { "$ref": "#/$defs/sha256" },
            "plan_sha256": { "$ref": "#/$defs/sha256" },
            "profile": { "const": "authoritative" },
            "report_count_by_platform": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ubuntu-22.04-x86_64",
                "ubuntu-24.04-aarch64"
              ],
              "properties": {
                "ubuntu-22.04-x86_64": {
                  "type": "integer",
                  "minimum": 20
                },
                "ubuntu-24.04-aarch64": {
                  "type": "integer",
                  "minimum": 20
                }
              }
            }
          }
        }
      ]
    },
    "platforms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ubuntu-22.04-x86_64",
        "ubuntu-24.04-aarch64"
      ],
      "properties": {
        "ubuntu-22.04-x86_64": { "$ref": "#/$defs/platform" },
        "ubuntu-24.04-aarch64": { "$ref": "#/$defs/platform" }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host_system", "host_machine", "pairs", "scenarios"],
      "properties": {
        "host_system": { "type": "string", "minLength": 1 },
        "host_machine": { "type": "string", "minLength": 1 },
        "pairs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pair_key",
              "left",
              "right",
              "max_median_elapsed_delta_pct"
            ],
            "properties": {
              "pair_key": { "type": "string", "minLength": 1 },
              "left": { "type": "string", "minLength": 1 },
              "right": { "type": "string", "minLength": 1 },
              "max_median_elapsed_delta_pct": { "type": "number" }
            }
          }
        },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pair_key",
              "condition",
              "metric_kind",
              "min_median_ops_per_second"
            ],
            "properties": {
              "pair_key": { "type": "string", "minLength": 1 },
              "condition": { "type": "string", "minLength": 1 },
              "metric_kind": {
                "enum": ["steady-state-kernel", "spawn-join-lifecycle"]
              },
              "min_median_ops_per_second": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      }
    }
  }
}
